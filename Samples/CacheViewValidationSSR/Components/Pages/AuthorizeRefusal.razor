@page "/authorize/refusal"

<PageTitle>AuthorizeView refusal</PageTitle>

<h1>AuthorizeView refusal</h1>

<p>This route intentionally omits <code>VaryByUser</code>. It should throw an <code>InvalidOperationException</code> that names <code>AuthorizeView</code> and explains how to fix the page.</p>

<CacheView>
    <AuthorizeView>
        <Authorized Context="authState">
            <p>Signed in as @authState.User.Identity?.Name.</p>
        </Authorized>
        <NotAuthorized>
            <p>The request is anonymous.</p>
        </NotAuthorized>
    </AuthorizeView>
</CacheView>
